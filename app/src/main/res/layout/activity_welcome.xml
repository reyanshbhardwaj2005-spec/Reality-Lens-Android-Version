<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_space">

    <!-- Skeleton Layout -->
    <include
        android:id="@+id/welcome_skeleton"
        layout="@layout/layout_skeleton_welcome"
        android:visibility="gone" />

    <!-- Actual Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/welcome_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/welcome_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="48dp"
            tools:context=".WelcomeActivity">

            <ImageView
                android:id="@+id/iv_success_check"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/ic_success_check"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_login_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="Login Successful"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_success_check" />

            <TextView
                android:id="@+id/tv_running_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="RealityLens is now active and protecting your digital experience."
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:alpha="0.9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_login_status" />

            <!-- Instruction Card (Glass Effect) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/instruction_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_dashboard_panel"
                android:padding="28dp"
                app:layout_constraintTop_toBottomOf="@id/tv_running_status">

                <TextView
                    android:id="@+id/tv_instruction_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Start Guide"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="1. Swipe down for Quick Settings.\n2. Tap the 'Snip Area' tile icon.\n3. Drag over any area to verify instantly."
                    android:textColor="#B0BEC5"
                    android:textSize="16sp"
                    android:lineSpacingExtra="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_instruction_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Works seamlessly over any app."
                    android:textColor="@color/accent_purple"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_instructions" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bottom Action Buttons -->
            <LinearLayout
                android:id="@+id/button_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/instruction_panel">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_minimize"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1AFFFFFF"
                    android:text="Minimize"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="100dp"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_dashboard"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_gradient_simple"
                    app:backgroundTint="@null"
                    android:text="Dashboard"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_dashboard_custom"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="100dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="RealityLens • Verified Reality"
                android:textColor="#455A64"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/button_layout" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
