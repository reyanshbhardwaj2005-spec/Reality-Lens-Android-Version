<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dashboard_panel"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:textColor="?attr/textPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_close_dialog"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/outline_close_24"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/textPrimary" />

    <View
        android:id="@+id/divider_header"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?attr/cardStrokeColor"
        android:alpha="0.3"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_title" />

    <!-- Mode Toggle (Username / Password) -->
    <LinearLayout
        android:id="@+id/ll_toggle_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_toggle_group"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/divider_header">

        <TextView
            android:id="@+id/tv_mode_username"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_gradient_simple"
            android:gravity="center"
            android:text="Username"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_mode_password"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Password"
            android:textColor="?attr/textSecondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Main Content Container -->
    <FrameLayout
        android:id="@+id/fl_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/ll_toggle_container">

        <!-- Username Edit Section -->
        <LinearLayout
            android:id="@+id/ll_username_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Username"
                android:textColor="?attr/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_panel"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/outline_account_circle_24"
                    app:tint="?attr/textSecondary" />

                <EditText
                    android:id="@+id/et_new_username"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Enter new username"
                    android:inputType="textPersonName"
                    android:paddingStart="12dp"
                    android:textColor="?attr/textPrimary"
                    android:textColorHint="?attr/textSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Password Edit Section -->
        <LinearLayout
            android:id="@+id/ll_password_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Password"
                android:textColor="?attr/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_panel"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="?attr/textSecondary" />

                <EditText
                    android:id="@+id/et_new_password"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Enter new password"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:textColor="?attr/textPrimary"
                    android:textColorHint="?attr/textSecondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/iv_password_toggle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_view"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Toggle Password Visibility"
                    app:tint="?attr/textSecondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="OTP Verification"
                android:textColor="?attr/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_panel"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/baseline_info_24"
                        app:tint="?attr/textSecondary" />

                    <EditText
                        android:id="@+id/et_otp_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:hint="Enter OTP"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:textColor="?attr/textPrimary"
                        android:textColorHint="?attr/textSecondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_otp"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="?attr/secondaryBackground"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/cardStrokeColor"
                    android:text="Send OTP"
                    android:textAllCaps="false"
                    android:textColor="?attr/textPrimary"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>


    <!-- Buttons -->
    <LinearLayout
        android:id="@+id/ll_dialog_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/fl_content_container"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="?attr/textPrimary"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/cardStrokeColor"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_changes"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Save Changes"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            android:background="@drawable/btn_gradient_simple"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>