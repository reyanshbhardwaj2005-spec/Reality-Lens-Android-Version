<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.RealiyLens" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>

        <!-- Neutralize M3 Surface Tints -->
        <item name="surfaceTint">@android:color/transparent</item>
        <item name="colorSurface">@color/deep_space</item>
        <item name="colorSurfaceVariant">@color/nebula_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">#B0BEC5</item>

        <item name="android:autofilledHighlight" tools:targetApi="26">@android:color/transparent</item>

        <!-- Modern Dark Theme Palette - Shifted to Black Shades -->
        <item name="mainBackground">@color/deep_space</item>
        <item name="secondaryBackground">@color/nebula_dark</item>
        <item name="textPrimary">@color/white</item>
        <item name="textSecondary">#B0BEC5</item>
        <item name="cardStrokeColor">@color/glass_stroke</item>
        <item name="rippleColor">@color/glass_white</item>
        <item name="skeletonColor">@color/glass_white</item>

        <!-- Gradient Background Attributes - Darkened to Black shades -->
        <item name="gradientStart">#0D0D0D</item>
        <item name="gradientCenter">#050505</item>
        <item name="gradientEnd">#000000</item>

        <!-- Cyberpunk Glass Effect Components - Restored Original Colors -->
        <item name="buttonGradientStart">@color/accent_cyan</item>
        <item name="buttonGradientCenter">#00B8D4</item>
        <item name="buttonGradientEnd">@color/accent_purple</item>
        <item name="buttonStroke">@color/glass_stroke</item>

        <item name="inputBgColor">@color/glass_white</item>
        <item name="inputStrokeColor">@color/glass_stroke</item>
    </style>
</resources>