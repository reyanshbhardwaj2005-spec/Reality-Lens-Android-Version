<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RealiyLens" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">#00D2FF</item>

        <!-- Fix yellow autofill highlight -->
        <item name="android:autofilledHighlight" tools:targetApi="26">@android:color/transparent</item>

        <!-- Custom Attributes for Dark Mode - Significantly lightened for clarity -->
        <item name="mainBackground">#1A1F2E</item>
        <item name="secondaryBackground">#2A3347</item>
        <item name="textPrimary">#FFFFFF</item>
        <item name="textSecondary">#E2E8F0</item>
        <item name="cardStrokeColor">#4A5568</item>
        <item name="rippleColor">#40FFFFFF</item>
        <item name="skeletonColor">#33FFFFFF</item>

        <!-- Component Specific for Dark Mode -->
        <item name="buttonGradientStart">#3B4A6B</item>
        <item name="buttonGradientCenter">#243354</item>
        <item name="buttonGradientEnd">#1A2642</item>
        <item name="buttonStroke">#00D2FF</item>

        <!-- High visibility for inputs -->
        <item name="inputBgColor">#33FFFFFF</item>
        <item name="inputStrokeColor">#66FFFFFF</item>

        <!-- Lighter Gradient Background -->
        <item name="gradientStart">#2D3748</item>
        <item name="gradientCenter">#1A202C</item>
        <item name="gradientEnd">#10141D</item>
    </style>
</resources>